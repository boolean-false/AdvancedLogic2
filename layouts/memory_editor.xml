<?xml version="1.0" encoding="utf-8"?>
<container position-func="gui.get_viewport()[1]/2-145,gui.get_viewport()[2]/2-255" size="290,510" color="#252525FF">

    <!-- Заголовок -->
    <panel pos="0,0" size="290,32" color="#2A2A2AFF" padding="12,8,12,8">
        <label id="mem_title" size="266,16" color="#FFFFFF" font-size="13" gravity="center-left">ROM / RAM</label>
    </panel>

    <!-- Конфигурация -->
    <panel pos="0,32" size="290,26" color="#1E1E1EFF" padding="6,3,6,3" orientation="horizontal" interval="8">
        <label id="btn_addr" size="127,20" color="#2A3A2AFF" gravity="center" font-size="10">Addr: 4b (fixed)</label>
        <button id="btn_data" size="127,20" color="#2A3A4AFF" hover-color="#3A4A6AFF" pressed-color="#1A2A3AFF" onclick="on_data_cycle()" text-align="center" font-size="10">Data: 4b</button>
    </panel>

    <!-- Колонка контента -->
    <panel pos="10,62" size="270,16" color="#1E1E1EFF" orientation="horizontal" interval="3">
        <label size="36,14" color="#888888" font-size="9">ADDR</label>
        <label size="54,14" color="#888888" font-size="9">DEC</label>
        <label size="96,14" color="#888888" font-size="9">BINARY</label>
        <label size="42,14" color="#888888" font-size="9">HEX</label>
    </panel>

    <!-- Скролл -->
    <panel id="mem_grid" pos="10,81" size="270,366" scrollable="true" max-length="366" orientation="vertical" interval="2" color="0"/>

    <!-- Сепаратор -->
    <panel pos="10,451" size="270,1" color="#444444FF"/>

    <!-- Нижние кнопки -->
    <panel pos="10,456" size="270,40" orientation="horizontal" interval="6" color="#252525FF">
        <button id="mem_apply" size="83,36" color="#2D7A2DFF" hover-color="#3A9A3AFF" pressed-color="#1F5A1FFF" onclick="on_mem_apply()" text-align="center">Применить</button>
        <button id="mem_clear" size="83,36" color="#7A2D2DFF" hover-color="#9A3A3AFF" pressed-color="#5A1F1FFF" onclick="on_mem_clear()" text-align="center">Сбросить</button>
        <button size="83,36" color="#5A5A5AFF" hover-color="#7A7A7AFF" pressed-color="#3A3A3AFF" onclick="on_mem_close()" text-align="center">Закрыть</button>
    </panel>

</container>
