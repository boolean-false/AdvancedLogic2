<?xml version="1.0" encoding="utf-8"?>
<container position-func="gui.get_viewport()[1]/2-220,gui.get_viewport()[2]/2-180" size="440,485" color="#252525FF">
    <panel pos="0,0" size="440,50" color="#2A2A2AFF" padding="15,10,15,10">
        <label pos="0,0" size="410,30" color="#FFFFFF" font-size="20" gravity="center-left">Настройки тактового генератора</label>
    </panel>
    
    <panel pos="20,50" size="400,110" color="#252525FF" padding="15,15,15,15">
        <label pos="0,0" size="370,25" color="#E0E0E0" font-size="14">Время импульса (секунды):</label>
        <textbox id="pulse_time" pos="0,30" size="370,40" text="0.50" editable="true" font-size="16" text-color="#FFFFFF" color="#1A1A1AFF" padding="10,8,10,8" />
        <label pos="0,75" size="370,20" color="#888888" font-size="11">Время, в течение которого выход включен</label>
    </panel>
    
    <panel pos="20,180" size="400,110" color="#252525FF" padding="15,15,15,15">
        <label pos="0,0" size="370,25" color="#E0E0E0" font-size="14">Время задержки (секунды):</label>
        <textbox id="delay_time" pos="0,30" size="370,40" text="0.50" editable="true" font-size="16" text-color="#FFFFFF" color="#1A1A1AFF" padding="10,8,10,8" />
        <label pos="0,75" size="370,20" color="#888888" font-size="11">Время, в течение которого выход выключен</label>
    </panel>
    
    <label id="run_status" pos="20,300" size="400,24">Генератор работает</label>
    <button pos="20,330" size="125,32" onclick="start_clock()">Пуск</button>
    <button pos="157,330" size="125,32" onclick="pause_clock()">Пауза</button>
    <button pos="294,330" size="125,32" onclick="cycle_clock()">Один такт</button>
    <label pos="20,373" size="400,24">Такт на паузе: 0 → 1 → 0. Только этот генератор.</label>
    <panel pos="20,420" size="400,50" orientation="horizontal" interval="15" padding="0,10,0,0"  color="#252525FF">
        <button id="apply_btn" pos="0,0" size="192,40" color="#2D7A2DFF" hover-color="#3A9A3AFF" pressed-color="#1F5A1FFF" onclick="apply_settings()" text-align="center">Применить</button>
        <button id="cancel_btn" pos="207,0" size="193,40" color="#5A2A2AFF" hover-color="#7A3A3AFF" pressed-color="#3A1A1AFF" onclick="close_gui()" text-align="center">Отмена</button>
    </panel>
</container>

