<?xml version="1.0" encoding="utf-8"?>
<container position-func="gui.get_viewport()[1]/2-150,gui.get_viewport()[2]/2-100" size="300,200" color="#252525FF">
    <panel pos="0,0" size="300,32" color="#2A2A2AFF" padding="12,8,12,8">
        <label size="276,16" color="#FFFFFF" font-size="13" gravity="center-left">Bus Constant</label>
    </panel>

    <panel pos="12,46" size="276,24" orientation="horizontal" interval="6" color="0">
        <label size="78,22" color="#AAAAAA" font-size="11">Значение:</label>
        <textbox id="value_input" size="192,22" editable="true" font-size="11" text-color="#FFFFFF" color="#1A1A1AFF"/>
    </panel>

    <panel pos="12,80" size="276,26" orientation="horizontal" interval="6" color="0">
        <label id="width_label" size="78,24" color="#66CCFF" font-size="11">4 бит</label>
        <button size="58,24" onclick="set_width(4)" color="#3A4A6AFF" hover-color="#5A6A8AFF">4 bit</button>
        <button size="58,24" onclick="set_width(8)" color="#3A4A6AFF" hover-color="#5A6A8AFF">8 bit</button>
        <button size="58,24" onclick="set_width(16)" color="#3A4A6AFF" hover-color="#5A6A8AFF">16 bit</button>
    </panel>

    <label id="range_label" pos="12,116" size="276,18" color="#888888" font-size="10">Диапазон: 0..15</label>

    <panel pos="12,156" size="276,28" orientation="horizontal" interval="8" color="0">
        <button size="134,26" onclick="apply_constant()" color="#286A48FF" hover-color="#3A8A60FF">Применить</button>
        <button size="134,26" onclick="close_constant()" color="#5A5A5AFF" hover-color="#777777FF">Закрыть</button>
    </panel>
</container>
